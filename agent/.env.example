MODE=hardware
SERVER_URL=http://127.0.0.1:8000
AGENT_TOKEN=

CAMERA_DEVICE=/dev/video0
GPIO_CHIP=0
GPIO_PINS=21,20,16,12,1,7,8,25
OPENOCD_COMMAND=openocd
OPENOCD_CONFIG=utils/board/max10.cfg

POLL_INTERVAL=5
TIMEOUT_SECONDS=300
RECORD_DURATION_SECONDS=15
STREAM_FPS=8
WORKSPACE=workspace
LOG_FILE=logs/agent.log
