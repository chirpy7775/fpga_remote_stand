[Unit]
Description=FPGA remote stand agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=CHANGE_ME
WorkingDirectory=/path/to/fpga_remote_stand/agent
ExecStart=/path/to/fpga_remote_stand/agent/run.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
