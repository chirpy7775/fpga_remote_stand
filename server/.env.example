HOST=0.0.0.0
PORT=8000
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=*

# Один стенд — одна строка. Имя после AGENT_TOKEN_ попадает в интерфейс.
# Тот же токен впиши в agent/.env как REMOTE_STAND_AGENT_TOKEN.
AGENT_TOKEN_stand-1=change-me

# Если логин с телефона/другого ПК ругается на CSRF, укажи URL как в браузере:
# DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.2.34:8000
